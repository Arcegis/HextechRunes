<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>HextechRunes</AssemblyName>
    <RootNamespace>HextechRunes</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GameRoot>/Users/iniad/Library/Application Support/Steam/steamapps/common/Slay the Spire 2/SlayTheSpire2.app</GameRoot>
    <GameDataDir>$(GameRoot)/Contents/Resources/data_sts2_macos_arm64</GameDataDir>
    <GameReleaseInfo>$(GameRoot)/Contents/Resources/release_info.json</GameReleaseInfo>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(GameReleaseInfo)') and $([System.IO.File]::ReadAllText('$(GameReleaseInfo)').Contains('v0.104.'))">
    <DefineConstants>$(DefineConstants);STS2_104_OR_NEWER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameDataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
