<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>HextechRunesSponsorPack</AssemblyName>
    <RootNamespace>HextechRunesSponsorPack</RootNamespace>
    <Version>0.9.2</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <HextechSponsorSts2Target Condition="'$(HextechSponsorSts2Target)' == ''">0.107.1</HextechSponsorSts2Target>
    <!--
      支持 0.107.1 / 0.110.0 / 0.111.0;版本符号、未知目标拦截、引用目录(与目标版本联动)
      以及 sts2/GodotSharp/0Harmony 引用都与本体共用仓库根 Directory.Build.targets。
    -->
    <HextechUsesVariantTargets>true</HextechUsesVariantTargets>
    <HextechVariantTarget>$(HextechSponsorSts2Target)</HextechVariantTarget>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="HextechSponsorCompatibilityTarget" Value="$(HextechSponsorSts2Target)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../HextechRunes/src/HextechRunes.csproj" Private="false" ReferenceOutputAssembly="true"
                      AdditionalProperties="HextechSts2Target=$(HextechSponsorSts2Target);GameDataDir=$(GameDataDir)" />
  </ItemGroup>
</Project>
