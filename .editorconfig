# 仓库唯一的 .editorconfig(本体、拓展包、加载器、测试与工具共用)。
# 仅约束新编辑内容;不对历史文件执行批量格式化。
root = true

[*.cs]
charset = utf-8
indent_style = tab
indent_size = 4
end_of_line = lf
insert_final_newline = true
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0005.severity = warning

[*.py]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true

[*.{json,csproj,props,targets}]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
